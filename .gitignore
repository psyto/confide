target/
node_modules/
dist/
.env
*.log
.DS_Store

# Private keys. account-keys.json holds the ElGamal secret that reads the confidential balance and
# the AES key that decrypts it; auditor-key.json holds the auditor's secret. Both are written by
# scripts into the repo root, and this repo is public, so one `git add -A` away from published.
# They were untracked only by luck until 2026-09-15.
account-keys.json
auditor-key.json

# The issuer's mint authority never belongs in the tree. It is written to
# $CONFIDE_PRIVATE_KEYS (default ~/.config/confide) by scripts/testbed-up.sh; this is a second
# line of defence in case it is ever put back here by mistake.
keys/issuer-mint-authority.json
keys/issuer.yml
